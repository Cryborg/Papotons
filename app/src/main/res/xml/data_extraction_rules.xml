<?xml version="1.0" encoding="utf-8"?>
<!--
  Sauvegarde automatique et transfert d'appareil (Android 12+).
  Tout est inclus : les grilles et les réglages de l'utilisateur sont précisément ce qu'il
  ne doit jamais perdre en changeant de tablette. ⚠️ La sauvegarde Google plafonne à
  25 Mo par appli : avec des photos, l'export manuel (.obz) reste indispensable.
-->
<data-extraction-rules>
    <cloud-backup />
    <device-transfer />
</data-extraction-rules>
