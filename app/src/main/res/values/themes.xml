<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Thème de l'appli, posé sur <application>. Fond noir de fenêtre : c'est ce
        qu'on voit entre la fin du splash système et la première image Compose,
        et il prolonge le noir du splash au lieu de flasher en blanc.
    -->
    <style name="Theme.App" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!--
        Thème de démarrage, posé sur la seule MainActivity. `installSplashScreen()`
        bascule ensuite sur `postSplashScreenTheme` : sans cet attribut, l'activité
        garderait le thème de splash.
    -->
    <style name="Theme.App.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.App</item>
    </style>
</resources>
